# 快速运行时镜像: 本地已构建 jar, 避免集群内重复 mvn 构建(离线集群无法下载依赖)
FROM eclipse-temurin:25-jre-alpine

RUN apk add --no-cache curl

RUN addgroup -g 1000 -S appgroup && \
    adduser -u 1000 -S appuser -G appgroup

WORKDIR /app
COPY target/iam-service-1.0.0-SNAPSHOT.jar app.jar
RUN chown -R appuser:appgroup /app

USER appuser
EXPOSE 8082

HEALTHCHECK --interval=30s --timeout=5s --start-period=120s --retries=10 \
  CMD curl -f http://localhost:8082/api/v1/actuator/health || exit 1

ENTRYPOINT ["java", "-XX:MaxRAMPercentage=75.0", "-jar", "app.jar"]
